{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "together-ledger-app-public-release-probe",
  "main": "./app-release-probe.mjs",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
